<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sync schedules, as both phones show them. %s is a time like "3:00 AM" or "03:00". -->
    <string name="schedule_daily">Every day at %1$s</string>
    <plurals name="schedule_every_hours">
        <item quantity="one">Every hour from %2$s</item>
        <item quantity="other">Every %1$d hours from %2$s</item>
    </plurals>
    <plurals name="schedule_every_days">
        <item quantity="one">Every day at %2$s</item>
        <item quantity="other">Every %1$d days at %2$s</item>
    </plurals>
    <!-- "Every Sunday at 8:00 PM" -->
    <string name="schedule_weekly">Every %1$s at %2$s</string>
    <string name="schedule_while_charging">Whenever charging</string>
    <string name="schedule_manual">Only when you tap Sync now</string>

    <string name="moment_today">today at %1$s</string>
    <string name="moment_tomorrow">tomorrow at %1$s</string>
    <!-- "Monday at 3:00 AM" -->
    <string name="moment_weekday">%1$s at %2$s</string>
</resources>
