{
  "name": "mediasync-rendezvous",
  "version": "0.0.0",
  "private": true,
  "description": "MediaSync rendezvous Worker: signaling mailbox, TURN credentials, FCM wake-up and relay usage meter",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:headers": "node scripts/check-license-headers.mjs",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "check:types": "wrangler types --include-runtime=false --strict-vars=false --check",
    "bundle": "wrangler deploy --dry-run --env production --outdir dist",
    "dev": "wrangler dev",
    "bundle:app": "node scripts/app-bundle.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261016.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
