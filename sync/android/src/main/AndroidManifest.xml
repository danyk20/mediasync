<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Encrypted connections between paired phones on the local network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Which network the phone is on, and its local addresses for the pairing QR code. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Finding the receiving phone on the network (mDNS). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Scheduled syncs and receive windows run as foreground services while charging (docs/PLAN.md §10.2). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- The ongoing notification of a background sync (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Wi-Fi locks keep the radio out of power saving during a session (docs/PLAN.md §7). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Turbo transfer: a direct Wi-Fi link between the two phones (docs/PLAN.md §8.3). Android 13+ asks to
         connect to nearby devices, never used for location. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <!-- Before Android 13, Wi-Fi Direct needs the location permission instead. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application>
        <!-- Wake-ups from the receiving phone's Worker (docs/PLAN.md §10.4). Firebase doesn't start on its own: only a
             receiving phone with internet sync turns it on. -->
        <service
            android:name=".WakeUpService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <!-- FCM's register() and onRegistered(), which replace getToken() and onNewToken(). -->
        <meta-data
            android:name="firebase_messaging_installation_id_enabled"
            android:value="true" />
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <!-- WorkManager's foreground service, declared with the type our long-running work uses. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
