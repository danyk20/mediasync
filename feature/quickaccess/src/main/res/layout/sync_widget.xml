<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sync_widget"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/sync_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_widget_title"
        android:textColor="@color/quick_widget_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sync_widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:text="@string/quick_never_synced"
        android:textColor="@color/quick_widget_text"
        android:textSize="14sp" />

    <Button
        android:id="@+id/sync_widget_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/sync_widget_button"
        android:minWidth="120dp"
        android:paddingHorizontal="20dp"
        android:text="@string/quick_sync_now"
        android:textAllCaps="false"
        android:textColor="@color/quick_widget_brand"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
