    <string name="diagnostics_empty">Zatiaľ nič nie je zaznamenané.</string>
    <string name="diagnostics_link_test">Test spojenia</string>
    <string name="diagnostics_link_test_intro">Meria, ako rýchlo môže tento telefón odosielať na %1$s, keď je na ňom otvorený MediaSync. Trvá asi 10 sekúnd.</string>
    <string name="diagnostics_link_test_start">Otestovať spojenie</string>
    <string name="diagnostics_link_test_running">Testujem…</string>
    <string name="diagnostics_link_test_failed">Na %1$s sa nedá dostať. Otvorte na ňom MediaSync, na rovnakej Wi-Fi, a skúste to znova.</string>
    <string name="diagnostics_link_test_one">Jedno spojenie: %1$s MB/s</string>
    <string name="diagnostics_link_test_four">Štyri spojenia: %1$s MB/s</string>
