    <string name="settings_updates_download">Stiahnuť</string>
    <string name="settings_updates_failed">Nepodarilo sa dostať k GitHubu. Skúste to neskôr.</string>
    <string name="settings_updates_note">Kontrola sa GitHubu opýta, ktoré vydanie je najnovšie. MediaSync neodosiela nič iné a nikdy nekontroluje sám od seba.</string>
