    <string name="diagnostics_title">Diagnostika</string>
    <string name="diagnostics_done">Hotovo</string>
    <string name="diagnostics_intro">Ak MediaSync nefunguje podľa očakávaní, zdieľajte tento záznam s tým, kto vám pomôže. Zostane v tomto telefóne, kým ho nezdieľate. Obsahuje, čo MediaSync robil a ako je tento telefón nastavený, bez fotiek, názvov súborov a miest.</string>
    <string name="diagnostics_share">Zdieľať záznam</string>
