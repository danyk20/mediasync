    <string name="settings_log_size_hint">Od 0,1 do 1024 MB. 1 MB, kým ju nezmeníte.</string>
    <string name="settings_log_size_invalid">Zadajte veľkosť od 0,1 do 1024 MB, napríklad 0,5 alebo 20.</string>
    <string name="settings_log_size_save">Uložiť</string>
